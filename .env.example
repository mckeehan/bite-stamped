# Copy to .env (git-ignored) and adjust. `npm start` reads it.

# Where the server listens. Keep 127.0.0.1 behind a reverse proxy;
# use 0.0.0.0 to reach it directly from other devices on your network.
PORT=8080
HOST=127.0.0.1

# Database, every file version, and a plain copy of the current files.
DATA_DIR=./data

# Who may sign in (comma-separated).
ALLOWED_EMAILS=you@example.com

# Sign-in codes by email. Without SMTP_URL they are printed in the server log.
#   smtps://user:password@smtp.example.com:465   (TLS)
#   smtp://user:password@smtp.example.com:587    (STARTTLS)
# URL-encode special characters in the user name and password (@ → %40).
# SMTP_URL=smtps://you%40example.com:app-password@smtp.example.com:465
# MAIL_FROM=you@example.com

# Set to 1 when a reverse proxy (Apache, Caddy, nginx, Tailscale serve) is in
# front, so the server sees the real https:// address and client IPs.
TRUST_PROXY=0

# Serve the app below a path of an existing site, e.g. /bites for
# https://example.com/bites/ (the proxy passes the full path through).
# BASE_PATH=/bites
