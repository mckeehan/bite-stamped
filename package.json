{
  "name": "bite-stamped",
  "version": "1.3.0",
  "private": true,
  "description": "Offline-first restaurant journal for the phone, stored as Markdown files with YAML headers, with a small self-hosted sync server.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --test test/*.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "import-eatlist": "node scripts/import-eatlist.mjs"
  }
}
